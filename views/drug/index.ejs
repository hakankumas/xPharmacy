<!DOCTYPE html>
<html lang="en">
    <head>
        <!-- prettier-ignore -->
        <%- include('../_partials/_head'); %>
        <%- include('../_partials/_cdn_datatables'); %>
        <!-- prettier-ignore -->
    </head>

    <body>
        <!-- prettier-ignore -->
        <%- include('../_partials/_header') %>
        <%- include('../_partials/_sidebar') %>
        <!-- prettier-ignore -->

        <main id="main" class="main" style="min-height: 100vh">
            <section class="section dashboard">
                <div class="row">
                    <div class="col-12 col-lg-8">
                        <div class="card">
                            <div
                                class="card-body"
                            >
                                <h1
                                    class="text-center pt-5"
                                    style="font-size: 24px; font-weight: bold"
                                >
                                    İlaç Satış Listesi
                                </h1>
                                <table
                                    id="table_drugs"
                                    class="display rounded"
                                    style="
                                        width: 100%;
                                        background-color: whitesmoke;
                                    "
                                >
                                    <thead>
                                        <tr>
                                            <th class="text-center">ID</th>
                                            <th>İlaç</th>
                                            <th class="text-center">Fiyat</th>
                                            <th class="text-center">Sil</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <!-- prettier-ignore -->
                                        <% list_drug.forEach(item => { %>
                                        <!-- prettier-ignore -->
                                        <tr>
                                            <td class="text-center"><%= item.drug_id %></td>
                                            <td><%= item.drug_name %></td>
                                            <td class="text-center"><%= item.drug_sale_price %> ₺</td>
                                            <td class="text-danger text-center">
                                                <a href="<%= baseURL %>/drug/delete/<%= item.drug_id %>" class="btn btn-outline-danger">Sil</a>
                                            </td>
                                        </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-4">
                        <div class="card mb-3">
                            <div class="card-body">
                                <h1
                                    class="text-center pt-5"
                                    style="font-size: 24px; font-weight: bold"
                                >
                                    İlaç Ekle
                                </h1>

                                <form
                                    class="row g-3"
                                    action="<%= baseURL %>/drug/create"
                                    method="POST"
                                >
                                    <div class="col-12">
                                        <label
                                            class="form-label"
                                            >İlaç Adı</label
                                        >
                                        <div
                                            class="input-group"
                                        >
                                            <input
                                                type="text"
                                                name="name"
                                                class="form-control"
                                                required
                                            />
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <label
                                            class="form-label"
                                            >Fiyatı</label
                                        >
                                        <input
                                            type="text"
                                            name="sale_price"
                                            placeholder="Örn: 49.99"
                                            class="form-control"
                                            required
                                        />
                                    </div>
                                    <div class="col-12">
                                        <button
                                            class="btn btn-success w-25"
                                            type="submit"
                                        >
                                            Ekle
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </main>

        <!-- prettier-ignore -->
        <%- include('../_partials/_footer') %>
        <%- include('../_partials/_arrowup') %>
        <%- include('../_partials/_scripts') %>
        <!-- prettier-ignore -->
        <script>
            new DataTable("#table_drugs", {
                paging: false,
                scrollCollapse: true,
                scrollY: "75vh",
                order: [[0, "desc"]],
            });
        </script>
    </body>
</html>

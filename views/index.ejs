                                        >
                                            <i class="bi bi-cart"></i>
                                        </div>
                                        <div class="ps-3">
                                            <h6>
                                                <%=
                                                count_amount_customer[0].number
                                                %>
                                            </h6>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-lg-3">
                            <div class="card info-card sales-card">
                                <div class="card-body">

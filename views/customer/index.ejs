<!DOCTYPE html>
<html lang="en">
    <head>
        <!-- prettier-ignore -->
        <%- include('../_partials/_head'); %>
        <%- include('../_partials/_cdn_datatables'); %>
        <!-- prettier-ignore -->
    </head>

    <body>
        <!-- prettier-ignore -->
        <%- include('../_partials/_header') %>
        <%- include('../_partials/_sidebar') %>
        <!-- prettier-ignore -->

        <main id="main" class="main" style="min-height: 100vh">
            <section class="section dashboard">
                <div class="row">
                    <div class="col-12 col-lg-7">
                        <div class="card">
                            <div
                                class="card-body"
                            >
                                <h1
                                    class="text-center pt-3"
                                    style="font-size: 24px"
                                >
                                    Alışveriş Geçmişi
                                </h1>
                                <table
                                    id="table_shopping"
                                    class="display rounded"
                                    style="
                                        width: 100%;
                                        background-color: whitesmoke;
                                    "
                                >
                                    <thead>
                                        <tr>
                                            <th class="text-center">ID</th>
                                            <th>Ad</th>
                                            <th>Soyad</th>
                                            <th>Cinsiyet</th>
                                            <th>İlaç</th>
                                            <th class="text-center">Fiyat</th>
                                            <th class="text-center">Adet</th>
                                            <th class="text-center">Toplam</th>
                                            <th class="text-center">Tarih</th>
                                            <th class="text-center">Sil</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <!-- prettier-ignore -->
                                        <% customers_orders.forEach(item => { %>
                                        <!-- prettier-ignore -->
                                        <tr>
                                            <td class="text-center"><%= item.customer_drug_id %></td>
                                            <td><%= item.customer_name %></td>
                                            <td><%= item.customer_surname %></td>
                                            <td><%= item.gender_name %></td>
                                            <td><%= item.drug_name %></td>
                                            <td class="text-center"><%= item.drug_sale_price %></td>
                                            <td class="text-center"><%= item.customer_drug_amount %></td>
                                            <td class="text-center"><%= item.drug_total_price %></td>
                                            <td class="text-center"><%= new Intl.DateTimeFormat("tr-TR", { day: "numeric", month: "short", year: "numeric" }).format(new Date(item.customer_drug_date)) %></td>
                                            <td class="text-danger text-center">
                                                <a href="<%= baseURL %>/customer/delete_shopping/<%= item.customer_drug_id %>" class="btn btn-outline-danger">Sil</a>
                                            </td>
                                        </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-5">
                        <div class="card">
                            <div
                                class="card-body"
                            >
                                <h1
                                    class="text-center pt-3"
                                    style="font-size: 24px"
                                >
                                    Müşterilerin Tekrar Eden Sipariş Sayıları
                                </h1>
                                <table
                                    id="table_repeat_shopping"
                                    class="display rounded"
                                    style="
                                        width: 100%;
                                        background-color: whitesmoke;
                                    "
                                >
                                    <thead>
                                        <tr>
                                            <th class="text-center">ID</th>
                                            <th>Ad</th>
                                            <th>Soyad</th>
                                            <th>Cinsiyet</th>
                                            <th class="text-center">Sipariş Sayısı</th>
                                            <th class="text-center">Sil</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <!-- prettier-ignore -->
                                        <% customers_number_of_process.forEach(item => { %>
                                        <!-- prettier-ignore -->
                                        <tr>
                                            <td class="text-center"><%= item.customer_id %></td>
                                            <td><%= item.customer_name %></td>
                                            <td><%= item.customer_surname %></td>
                                            <td><%= item.gender_name %></td>
                                            <td class="text-center"><%= item.number %></td>
                                            <td class="text-danger text-center">
                                                <a href="<%= baseURL %>/customer/delete_id/<%= item.customer_id %>" class="btn btn-outline-danger">Sil</a>
                                            </td>
                                        </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </main>

        <!-- prettier-ignore -->
        <%- include('../_partials/_footer') %>
        <%- include('../_partials/_arrowup') %>
        <%- include('../_partials/_scripts') %>
        <!-- prettier-ignore -->
        <script>
            new DataTable("#table_shopping", {
                paging: false,
                scrollCollapse: true,
                scrollY: "75vh",
                order: [[0, "desc"]],
            });
            new DataTable("#table_repeat_shopping", {
                paging: false,
                scrollCollapse: true,
                scrollY: "75vh",
                order: [[4, "desc"]],
            });
        </script>
    </body>
</html>
